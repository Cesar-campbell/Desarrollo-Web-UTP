# =====================================================================
# includes/.htaccess
# Seguridad perimetral: los componentes (header, footer, formulario)
# solo deben usarse mediante include desde index.php o procesar.php.
# Apache niega el acceso directo por URL a todo lo que hay aquí.
# =====================================================================

# Apache 2.4 o superior (WAMP actual)
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 (versiones antiguas)
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
